// F35's live check, window totals and peaks for B's session minutes with the new Snapshot Value in place of the model's,
// and every measure the query evaluates defined in it too (with the TMDL's expressions), since a model measure reads the
// deployed Snapshot Value whatever the query defines. They must equal fabric/app/scripts/f35-reference.ts's exactly.
// B's session (2026-11-21): its SQL save's window was 15:19:04 to 16:59:04 UTC, and its Azure Monitor captures' 15:14 to
// 16:57, inside a day-long save four hours later. Bins from 15:00 to 17:15 hold the partly covered 15-minute ones at both ends.
DEFINE
    MEASURE 'Telemetry Snapshots'[Snapshot Value] =
        SUMX (
            SUMMARIZE (
                'Telemetry Snapshots',
                'Telemetry Snapshots'[Target Key],
                'Telemetry Snapshots'[Analysis Key],
                'Telemetry Snapshots'[Metric],
                'Telemetry Snapshots'[Bucket UTC]
            ),
            VAR Bin = 'Telemetry Snapshots'[Bucket UTC]
            VAR AnalysisName = 'Telemetry Snapshots'[Analysis Key]
            VAR MetricName = 'Telemetry Snapshots'[Metric]
            VAR OffGrid = ISBLANK ( Bin ) || AnalysisName IN { "wait_profile", "estate_pulse", "memory_clerks", "database_growth", "telemetry_coverage" }
            RETURN
                IF (
                    OffGrid,
                    VAR NewestCapture = CALCULATE ( MAX ( 'Telemetry Snapshots'[Captured At UTC] ) )
                    RETURN
                        CALCULATE ( SUM ( 'Telemetry Snapshots'[Value] ), 'Telemetry Snapshots'[Captured At UTC] = NewestCapture ),
                    VAR Adds = AnalysisName IN { "wait_deltas", "counter_deltas", "storage_io" } || MetricName IN { "TotalRequests", "ThrottledRequests", "TotalRequestUnits", "connections_failed" }
                    VAR IsMonitor = AnalysisName IN { "postgresql", "cosmosdb" }
                    VAR IsHourly = MetricName IN { "ProvisionedThroughput", "ServiceAvailability" }
                    VAR SeriesSaves =
                        ADDCOLUMNS (
                            ADDCOLUMNS (
                                CALCULATETABLE (
                                    SUMMARIZE (
                                        'Telemetry Snapshots',
                                        'Telemetry Snapshots'[Captured At UTC],
                                        'Telemetry Snapshots'[Window Start UTC],
                                        'Telemetry Snapshots'[Window End UTC]
                                    ),
                                    REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                    REMOVEFILTERS ( 'Date' )
                                ),
                                "@Grain",
                                    VAR SpanMinutes = ( 'Telemetry Snapshots'[Window End UTC] - 'Telemetry Snapshots'[Window Start UTC] ) * 1440
                                    VAR FromMinute = ROUND ( ( 'Telemetry Snapshots'[Window Start UTC] - DATE ( 1970, 1, 1 ) ) * 1440, 0 )
                                    VAR ToMinute = ROUND ( ( 'Telemetry Snapshots'[Window End UTC] - DATE ( 1970, 1, 1 ) ) * 1440, 0 )
                                    VAR SaveStep =
                                        IF (
                                            IsMonitor,
                                            VAR SaveBins =
                                                CALCULATETABLE (
                                                    VALUES ( 'Telemetry Snapshots'[Bucket UTC] ),
                                                    REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Metric], 'Telemetry Snapshots'[Report Date UTC] ),
                                                    REMOVEFILTERS ( 'Date' ),
                                                    NOT ( 'Telemetry Snapshots'[Metric] IN { "ProvisionedThroughput", "ServiceAvailability" } )
                                                )
                                            VAR Bins = COUNTROWS ( SaveBins )
                                            VAR BinMinutes = SELECTCOLUMNS ( SaveBins, "@Minute", ROUND ( ( 'Telemetry Snapshots'[Bucket UTC] - DATE ( 1970, 1, 1 ) ) * 1440, 0 ) )
                                            RETURN
                                                IF (
                                                    Bins > 0,
                                                    MAXX (
                                                        FILTER (
                                                            SELECTCOLUMNS ( { 1, 5, 15, 30, 60, 180, 360, 720, 1440 }, "@Step", [Value] ),
                                                            VAR StepNow = [@Step]
                                                            RETURN
                                                                ( CEILING ( ToMinute, StepNow ) - FLOOR ( FromMinute, StepNow ) ) / StepNow >= Bins
                                                                    && ISEMPTY ( FILTER ( BinMinutes, MOD ( [@Minute], StepNow ) <> 0 ) )
                                                        ),
                                                        [@Step]
                                                    ),
                                                    60
                                                ),
                                            IF ( SpanMinutes <= 120.000001, 1, IF ( SpanMinutes <= 720.000001, 5, 15 ) )
                                        )
                                    RETURN
                                        IF ( IsHourly, MAX ( 60, SaveStep ), SaveStep ),
                                "@First",
                                    CALCULATE (
                                        MIN ( 'Telemetry Snapshots'[Bucket UTC] ),
                                        REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                        REMOVEFILTERS ( 'Date' )
                                    ),
                                "@Last",
                                    CALCULATE (
                                        MAX ( 'Telemetry Snapshots'[Bucket UTC] ),
                                        REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                        REMOVEFILTERS ( 'Date' )
                                    ),
                                "@Count",
                                    CALCULATE (
                                        DISTINCTCOUNT ( 'Telemetry Snapshots'[Bucket UTC] ),
                                        REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                        REMOVEFILTERS ( 'Date' )
                                    )
                            ),
                            "@RowFrom", MAX ( [@First], 'Telemetry Snapshots'[Window Start UTC] ),
                            "@RowTo", MIN ( [@Last] + [@Grain] / 1440, 'Telemetry Snapshots'[Window End UTC] ),
                            "@Dense", [@Count] = ROUND ( ( [@Last] - [@First] ) * 1440 / [@Grain], 0 ) + 1
                        )
                    VAR AtBin =
                        ADDCOLUMNS (
                            CALCULATETABLE ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Captured At UTC] ) ),
                            "@Point", CALCULATE ( SUM ( 'Telemetry Snapshots'[Value] ) )
                        )
                    VAR Owns =
                        ADDCOLUMNS (
                            AtBin,
                            "@Own",
                                VAR Captured = 'Telemetry Snapshots'[Captured At UTC]
                                VAR PointValue = [@Point]
                                VAR ThisSave = FILTER ( SeriesSaves, 'Telemetry Snapshots'[Captured At UTC] = Captured )
                                VAR Grain = MAXX ( ThisSave, [@Grain] )
                                VAR CutStart = MAX ( Bin, MAXX ( ThisSave, 'Telemetry Snapshots'[Window Start UTC] ) )
                                VAR CutEnd = MIN ( Bin + Grain / 1440, MAXX ( ThisSave, 'Telemetry Snapshots'[Window End UTC] ) )
                                VAR SpanStart = IF ( CutStart < CutEnd, CutStart, Bin )
                                VAR SpanEnd = IF ( CutStart < CutEnd, CutEnd, Bin + Grain / 1440 )
                                VAR Finer =
                                    FILTER (
                                        SeriesSaves,
                                        ( [@Grain] < Grain || ( [@Grain] = Grain && 'Telemetry Snapshots'[Captured At UTC] > Captured ) )
                                            && [@RowFrom] < SpanEnd
                                            && [@RowTo] > SpanStart
                                    )
                                VAR DenseCover =
                                    NOT ISEMPTY (
                                        FILTER (
                                            Finer,
                                            [@Dense]
                                                && [@RowFrom] <= SpanStart + 0.00000001
                                                && [@RowTo] >= SpanEnd - 0.00000001
                                        )
                                    )
                                RETURN
                                    IF (
                                        ISEMPTY ( Finer ),
                                        PointValue,
                                        IF (
                                            DenseCover,
                                            BLANK (),
                                            VAR Inside =
                                                ADDCOLUMNS (
                                                    ADDCOLUMNS (
                                                        FILTER (
                                                            GROUPBY (
                                                                CALCULATETABLE (
                                                                    'Telemetry Snapshots',
                                                                    // Every row of the finer saves for this series, whatever its bin, so all of the series' bins share one
                                                                    // read: the context transition's filters on the bin and the save are removed first. The finer saves
                                                                    // come from SeriesSaves, so an outside filter on Captured At UTC hides a save here too.
                                                                    REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Captured At UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                                                    REMOVEFILTERS ( 'Date' ),
                                                                    TREATAS ( SELECTCOLUMNS ( Finer, "@Save", 'Telemetry Snapshots'[Captured At UTC] ), 'Telemetry Snapshots'[Captured At UTC] )
                                                                ),
                                                                'Telemetry Snapshots'[Bucket UTC],
                                                                'Telemetry Snapshots'[Captured At UTC],
                                                                "@Value", SUMX ( CURRENTGROUP (), 'Telemetry Snapshots'[Value] )
                                                            ),
                                                            'Telemetry Snapshots'[Bucket UTC] >= Bin
                                                                && 'Telemetry Snapshots'[Bucket UTC] < Bin + Grain / 1440
                                                        ),
                                                        "@G",
                                                            VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                            RETURN MAXX ( FILTER ( Finer, 'Telemetry Snapshots'[Captured At UTC] = RowSave ), [@Grain] ),
                                                        "@From",
                                                            VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                            RETURN MAXX ( FILTER ( Finer, 'Telemetry Snapshots'[Captured At UTC] = RowSave ), 'Telemetry Snapshots'[Window Start UTC] ),
                                                        "@To",
                                                            VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                            RETURN MAXX ( FILTER ( Finer, 'Telemetry Snapshots'[Captured At UTC] = RowSave ), 'Telemetry Snapshots'[Window End UTC] )
                                                    ),
                                                    "@CoverStart",
                                                        VAR RowBin = 'Telemetry Snapshots'[Bucket UTC]
                                                        VAR RowStart = MAX ( RowBin, [@From] )
                                                        VAR RowEnd = MIN ( RowBin + [@G] / 1440, [@To] )
                                                        RETURN IF ( RowStart < RowEnd, RowStart, RowBin ),
                                                    "@CoverEnd",
                                                        VAR RowBin = 'Telemetry Snapshots'[Bucket UTC]
                                                        VAR RowStart = MAX ( RowBin, [@From] )
                                                        VAR RowEnd = MIN ( RowBin + [@G] / 1440, [@To] )
                                                        RETURN IF ( RowStart < RowEnd, RowEnd, RowBin + [@G] / 1440 )
                                                )
                                            VAR Ranked =
                                                ADDCOLUMNS (
                                                    Inside,
                                                    "@Rank",
                                                        VAR RowGrain = [@G]
                                                        VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                        RETURN 1 + COUNTROWS ( FILTER ( Finer, [@Grain] < RowGrain || ( [@Grain] = RowGrain && 'Telemetry Snapshots'[Captured At UTC] > RowSave ) ) )
                                                )
                                            VAR Level1 =
                                                ADDCOLUMNS (
                                                    ADDCOLUMNS ( FILTER ( Ranked, [@Rank] = 1 ), "@Any", FALSE (), "@Sum", 0.0, "@Covered", FALSE () ),
                                                    "@Kept", [@Value],
                                                    "@Taken", [@Value]
                                                )
                                            VAR Level2 =
                                                ADDCOLUMNS (
                                                    ADDCOLUMNS (
                                                        FILTER ( Ranked, [@Rank] = 2 ),
                                                        "@Any",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            RETURN NOT ISEMPTY ( FILTER ( Level1, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ) ),
                                                        "@Sum",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            RETURN 0.0 + SUMX ( FILTER ( Level1, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ), [@Kept] ),
                                                        "@Covered",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            VAR Under = FILTER ( Level1, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom )
                                                            RETURN
                                                                NOT ISEMPTY ( Under )
                                                                    && ISEMPTY (
                                                                        FILTER (
                                                                            UNION ( ROW ( "@X", RowFrom ), SELECTCOLUMNS ( FILTER ( Under, [@CoverEnd] < RowTo - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                                            VAR X = [@X]
                                                                            RETURN ISEMPTY ( FILTER ( Under, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                                        )
                                                                    )
                                                    ),
                                                    "@Kept", IF ( NOT [@Any], [@Value], IF ( [@Covered], 0.0, MAX ( 0.0, [@Value] - [@Sum] ) ) ),
                                                    "@Taken", IF ( [@Covered], BLANK (), [@Value] )
                                                )
                                            VAR Upto2 = UNION ( Level1, Level2 )
                                            VAR Level3 =
                                                ADDCOLUMNS (
                                                    ADDCOLUMNS (
                                                        FILTER ( Ranked, [@Rank] = 3 ),
                                                        "@Any",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            RETURN NOT ISEMPTY ( FILTER ( Upto2, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ) ),
                                                        "@Sum",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            RETURN 0.0 + SUMX ( FILTER ( Upto2, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ), [@Kept] ),
                                                        "@Covered",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            VAR Under = FILTER ( Upto2, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom )
                                                            RETURN
                                                                NOT ISEMPTY ( Under )
                                                                    && ISEMPTY (
                                                                        FILTER (
                                                                            UNION ( ROW ( "@X", RowFrom ), SELECTCOLUMNS ( FILTER ( Under, [@CoverEnd] < RowTo - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                                            VAR X = [@X]
                                                                            RETURN ISEMPTY ( FILTER ( Under, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                                        )
                                                                    )
                                                    ),
                                                    "@Kept", IF ( NOT [@Any], [@Value], IF ( [@Covered], 0.0, MAX ( 0.0, [@Value] - [@Sum] ) ) ),
                                                    "@Taken", IF ( [@Covered], BLANK (), [@Value] )
                                                )
                                            VAR Upto3 = UNION ( Upto2, Level3 )
                                            VAR Level4 =
                                                ADDCOLUMNS (
                                                    ADDCOLUMNS (
                                                        FILTER ( Ranked, [@Rank] >= 4 ),
                                                        "@Any",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            RETURN NOT ISEMPTY ( FILTER ( Upto3, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ) ),
                                                        "@Sum",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            RETURN 0.0 + SUMX ( FILTER ( Upto3, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ), [@Kept] ),
                                                        "@Covered",
                                                            VAR RowFrom = [@CoverStart]
                                                            VAR RowTo = [@CoverEnd]
                                                            VAR Under = FILTER ( Upto3, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom )
                                                            RETURN
                                                                NOT ISEMPTY ( Under )
                                                                    && ISEMPTY (
                                                                        FILTER (
                                                                            UNION ( ROW ( "@X", RowFrom ), SELECTCOLUMNS ( FILTER ( Under, [@CoverEnd] < RowTo - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                                            VAR X = [@X]
                                                                            RETURN ISEMPTY ( FILTER ( Under, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                                        )
                                                                    )
                                                    ),
                                                    "@Kept", IF ( NOT [@Any], [@Value], IF ( [@Covered], 0.0, MAX ( 0.0, [@Value] - [@Sum] ) ) ),
                                                    "@Taken", IF ( [@Covered], BLANK (), [@Value] )
                                                )
                                            VAR Kept = UNION ( Upto3, Level4 )
                                            VAR UnderPoint = FILTER ( Kept, [@CoverStart] < SpanEnd && [@CoverEnd] > SpanStart )
                                            VAR CoveredPoint =
                                                NOT ISEMPTY ( UnderPoint )
                                                    && ISEMPTY (
                                                        FILTER (
                                                            UNION ( ROW ( "@X", SpanStart ), SELECTCOLUMNS ( FILTER ( UnderPoint, [@CoverEnd] < SpanEnd - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                            VAR X = [@X]
                                                            RETURN ISEMPTY ( FILTER ( UnderPoint, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                        )
                                                    )
                                            VAR Highest = MAXX ( UnderPoint, [@Taken] )
                                            RETURN
                                                IF (
                                                    ISEMPTY ( UnderPoint ),
                                                    PointValue,
                                                    IF (
                                                        CoveredPoint,
                                                        BLANK (),
                                                        IF (
                                                            Adds,
                                                            MAX ( 0, PointValue - SUMX ( UnderPoint, [@Kept] ) ),
                                                            IF ( ISBLANK ( Highest ) || PointValue > Highest, PointValue )
                                                        )
                                                    )
                                                )
                                        )
                                    )
                        )
                    RETURN
                        IF ( Adds, SUMX ( Owns, [@Own] ), MAXX ( Owns, [@Own] ) )
                )
        )
    MEASURE 'Telemetry Snapshots'[Cosmos DB Requests] =
        CALCULATE (
            [Snapshot Value],
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "TotalRequests" )
        )
    MEASURE 'Telemetry Snapshots'[Lock Wait (s)] =
        DIVIDE (
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "wait_deltas" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Lock" )
            ),
            1000
        )
    MEASURE 'Telemetry Snapshots'[Wait Time (s)] =
        DIVIDE ( CALCULATE ( [Snapshot Value], KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "wait_deltas" ) ), 1000 )
    MEASURE 'Telemetry Snapshots'[Buffer IO Wait (s)] =
        DIVIDE (
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "wait_deltas" ),
                KEEPFILTERS ( FILTER ( ALL ( 'Telemetry Snapshots'[Metric] ), CONTAINSSTRING ( 'Telemetry Snapshots'[Metric], "(PAGEIOLATCH)" ) ) )
            ),
            1000
        )
    MEASURE 'Telemetry Snapshots'[Data and Log IO (MB)] =
        CALCULATE (
            [Snapshot Value],
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "storage_io" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] IN { "ReadMB", "WriteMB" } )
        )
    MEASURE 'Telemetry Snapshots'[Batch Requests] =
        CALCULATE (
            [Snapshot Value],
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "counter_deltas" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Batch Requests/sec" )
        )
    MEASURE 'Telemetry Snapshots'[Deadlocks] =
        CALCULATE (
            [Snapshot Value],
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "counter_deltas" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Number of Deadlocks/sec" )
        )
    MEASURE 'Telemetry Snapshots'[CPU Peak (%)] =
        CALCULATE (
            MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cpu" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "MaxCPU" )
        )
    MEASURE 'Telemetry Snapshots'[Blocked Processes (peak)] =
        CALCULATE (
            MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "gauges" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Processes blocked" )
        )
    MEASURE 'Telemetry Snapshots'[Active Sessions (peak)] =
        CALCULATE (
            MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "sessions" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "MaxSessions" )
        )
    MEASURE 'Telemetry Snapshots'[Throttled Requests (429s)] =
        VAR Throttled =
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "ThrottledRequests" )
            )
        RETURN IF ( ISBLANK ( Throttled ) && NOT ISBLANK ( [Cosmos DB Requests] ), 0, Throttled )
    MEASURE 'Telemetry Snapshots'[RU Consumed] =
        CALCULATE (
            [Snapshot Value],
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "TotalRequestUnits" )
        )
    MEASURE 'Telemetry Snapshots'[Peak Norm RU (%)] =
        CALCULATE (
            MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "NormalizedRUConsumption" )
        )
    MEASURE 'Telemetry Snapshots'[Replica Lag Peak (s)] =
        CALCULATE (
            MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "postgresql" ),
            KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "physical_replication_delay_in_seconds" )
        )
EVALUATE
SUMMARIZECOLUMNS (
    'Target'[Target Key],
    FILTER (
        ALL ( 'Telemetry Snapshots'[Bucket UTC] ),
        'Telemetry Snapshots'[Bucket UTC] >= DATE ( 2026, 11, 21 ) + TIME ( 15, 0, 0 )
            && 'Telemetry Snapshots'[Bucket UTC] < DATE ( 2026, 11, 21 ) + TIME ( 17, 15, 0 )
    ),
        "LockWaitS", [Lock Wait (s)],
        "WaitS", [Wait Time (s)],
        "BufferIoS", [Buffer IO Wait (s)],
        "IoMb", [Data and Log IO (MB)],
        "Batch", [Batch Requests],
        "Deadlocks", [Deadlocks],
        "CpuPeak", [CPU Peak (%)],
        "BlockedPeak", [Blocked Processes (peak)],
        "SessionsPeak", [Active Sessions (peak)],
        "Requests", [Cosmos DB Requests],
        "Throttled", [Throttled Requests (429s)],
        "RuConsumed", [RU Consumed],
        "NormRuPeak", [Peak Norm RU (%)],
        "ReplicaLagPeak", [Replica Lag Peak (s)]
)
ORDER BY 'Target'[Target Key]
