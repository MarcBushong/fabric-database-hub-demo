// F35's live check, rows 2 of 3: one row with no bin and no value for each SQL series and save whose window overlaps the
// bins from 14:45 to 17:30, with its rows' first and last bin and how many bins it has, over the whole save: the measure
// reads each save of a series whole, and the reference takes these rows as saves only. Read-only; no resource names.
// B's session (2026-11-21): its SQL save's window was 15:19:04 to 16:59:04 UTC, and its Azure Monitor captures' 15:14 to
// 16:57, inside a day-long save four hours later. Bins from 15:00 to 17:15 hold the partly covered 15-minute ones at both ends.
EVALUATE
VAR NearFrom = DATE ( 2026, 11, 21 ) + TIME ( 14, 45, 0 )
VAR NearTo = DATE ( 2026, 11, 21 ) + TIME ( 17, 30, 0 )
VAR Saves =
    FILTER (
        CALCULATETABLE (
            SUMMARIZE (
                'Telemetry Snapshots',
                'Telemetry Snapshots'[Target Key],
                'Telemetry Snapshots'[Analysis Key],
                'Telemetry Snapshots'[Metric],
                'Telemetry Snapshots'[Captured At UTC],
                'Telemetry Snapshots'[Window Start UTC],
                'Telemetry Snapshots'[Window End UTC]
            ),
            NOT ( 'Telemetry Snapshots'[Analysis Key] IN { "postgresql", "cosmosdb", "wait_profile", "estate_pulse", "memory_clerks", "database_growth", "telemetry_coverage" } )
        ),
        'Telemetry Snapshots'[Window Start UTC] < NearTo
            && 'Telemetry Snapshots'[Window End UTC] > NearFrom
    )
RETURN
    SELECTCOLUMNS (
        Saves,
        "Bucket", BLANK (),
        "TargetKey", 'Telemetry Snapshots'[Target Key],
        "AnalysisKey", 'Telemetry Snapshots'[Analysis Key],
        "Metric", 'Telemetry Snapshots'[Metric],
        "Value", BLANK (),
        "WindowStart", 'Telemetry Snapshots'[Window Start UTC],
        "WindowEnd", 'Telemetry Snapshots'[Window End UTC],
        "CapturedAt", 'Telemetry Snapshots'[Captured At UTC],
        "First", CALCULATE ( MIN ( 'Telemetry Snapshots'[Bucket UTC] ) ),
        "Last", CALCULATE ( MAX ( 'Telemetry Snapshots'[Bucket UTC] ) ),
        "Count", CALCULATE ( DISTINCTCOUNT ( 'Telemetry Snapshots'[Bucket UTC] ) )
    )
