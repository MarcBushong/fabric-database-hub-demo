/// History of the Fabric Database Hub demo from the lakehouse snapshots that the notebooks write: telemetry bins, findings, validation checks, scenario requests, and incident windows. All times are UTC. The live view is Database Hub and the Real-Time Dashboard.
model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    discourageImplicitMeasures
    sourceQueryCulture: en-US

ref table 'Validation Results'
ref table 'Scenario Runs'
ref table 'Telemetry Snapshots'
ref table 'Analysis Findings'
ref table 'Incident Windows'
ref table Target
ref table Status
ref table Analysis
ref table Signal
ref table Date
