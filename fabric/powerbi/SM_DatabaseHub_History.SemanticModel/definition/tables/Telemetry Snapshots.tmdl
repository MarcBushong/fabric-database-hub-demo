/// One value per notebook run, analysis, target, resource, instance, database, metric, and bin, from dbo.telemetry_snapshots. Overlapping notebook runs store a time more than once, each at its own grain; every measure takes each interval from its finest save (Snapshot Value, F35).
table 'Telemetry Snapshots'

    /// Base measure (F35). Per target, analysis, metric, and bin, each save's point there, by the shared rule of fabric/app/src/data/finest-per-interval.ts: the finest grain first, then the newest save. A coarser point stays only for the minutes the finer saves' rows don't cover, a total as what's left after what those rows keep and a maximum or an average only when it's higher; its remainder shows at its own bin's start. It reads the finer saves' rows wherever they reach into a coarser interval, unless one of those saves has a row in every one of its intervals there; each save is read whole, whatever the period selected. Totals add, maxima and averages take the highest, and inside a save it sums across instances and files. Off the bin grid, the newest capture. Every telemetry measure builds on it.
    measure 'Snapshot Value' =
            SUMX (
                SUMMARIZE (
                    'Telemetry Snapshots',
                    'Telemetry Snapshots'[Target Key],
                    'Telemetry Snapshots'[Analysis Key],
                    'Telemetry Snapshots'[Metric],
                    'Telemetry Snapshots'[Bucket UTC]
                ),
                VAR Bin = 'Telemetry Snapshots'[Bucket UTC]
                VAR AnalysisName = 'Telemetry Snapshots'[Analysis Key]
                VAR MetricName = 'Telemetry Snapshots'[Metric]
                VAR OffGrid = ISBLANK ( Bin ) || AnalysisName IN { "wait_profile", "estate_pulse", "memory_clerks", "database_growth", "telemetry_coverage" }
                RETURN
                    IF (
                        OffGrid,
                        VAR NewestCapture = CALCULATE ( MAX ( 'Telemetry Snapshots'[Captured At UTC] ) )
                        RETURN
                            CALCULATE ( SUM ( 'Telemetry Snapshots'[Value] ), 'Telemetry Snapshots'[Captured At UTC] = NewestCapture ),
                        VAR Adds = AnalysisName IN { "wait_deltas", "counter_deltas", "storage_io" } || MetricName IN { "TotalRequests", "ThrottledRequests", "TotalRequestUnits", "connections_failed" }
                        VAR IsMonitor = AnalysisName IN { "postgresql", "cosmosdb" }
                        VAR IsHourly = MetricName IN { "ProvisionedThroughput", "ServiceAvailability" }
                        VAR SaveList =
                            CALCULATETABLE (
                                SUMMARIZE (
                                    'Telemetry Snapshots',
                                    'Telemetry Snapshots'[Captured At UTC],
                                    'Telemetry Snapshots'[Window Start UTC],
                                    'Telemetry Snapshots'[Window End UTC]
                                ),
                                REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                REMOVEFILTERS ( 'Date' )
                            )
                        RETURN
                            IF (
                                COUNTROWS ( SaveList ) <= 1,
                                // One save holds the series, so its point is the value.
                                CALCULATE ( SUM ( 'Telemetry Snapshots'[Value] ) ),
                                VAR AtBin =
                                    ADDCOLUMNS (
                                        CALCULATETABLE ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Captured At UTC] ) ),
                                        "@Point", CALCULATE ( SUM ( 'Telemetry Snapshots'[Value] ) )
                                    )
                                VAR AtBinSaves = SELECTCOLUMNS ( AtBin, "@Save", 'Telemetry Snapshots'[Captured At UTC] )
                                VAR NearSaves =
                                    ADDCOLUMNS (
                                        // Only a save with a point here, or one whose window reaches the day from this bin, can weigh on
                                        // the bin's points, since a step is at most a day: the work doesn't grow with the history.
                                        FILTER (
                                            SaveList,
                                            ( 'Telemetry Snapshots'[Window Start UTC] < Bin + 1 && 'Telemetry Snapshots'[Window End UTC] > Bin )
                                                || 'Telemetry Snapshots'[Captured At UTC] IN AtBinSaves
                                        ),
                                        "@Grain",
                                            VAR SpanMinutes = ( 'Telemetry Snapshots'[Window End UTC] - 'Telemetry Snapshots'[Window Start UTC] ) * 1440
                                            VAR FromMinute = ROUND ( ( 'Telemetry Snapshots'[Window Start UTC] - DATE ( 1970, 1, 1 ) ) * 1440, 0 )
                                            VAR ToMinute = ROUND ( ( 'Telemetry Snapshots'[Window End UTC] - DATE ( 1970, 1, 1 ) ) * 1440, 0 )
                                            VAR SaveStep =
                                                IF (
                                                    IsMonitor,
                                                    VAR SaveBins =
                                                        CALCULATETABLE (
                                                            VALUES ( 'Telemetry Snapshots'[Bucket UTC] ),
                                                            REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Metric], 'Telemetry Snapshots'[Report Date UTC] ),
                                                            REMOVEFILTERS ( 'Date' ),
                                                            NOT ( 'Telemetry Snapshots'[Metric] IN { "ProvisionedThroughput", "ServiceAvailability" } )
                                                        )
                                                    VAR Bins = COUNTROWS ( SaveBins )
                                                    VAR BinMinutes = SELECTCOLUMNS ( SaveBins, "@Minute", ROUND ( ( 'Telemetry Snapshots'[Bucket UTC] - DATE ( 1970, 1, 1 ) ) * 1440, 0 ) )
                                                    RETURN
                                                        IF (
                                                            Bins > 0,
                                                            MAXX (
                                                                FILTER (
                                                                    SELECTCOLUMNS ( { 1, 5, 15, 30, 60, 180, 360, 720, 1440 }, "@Step", [Value] ),
                                                                    VAR StepNow = [@Step]
                                                                    RETURN
                                                                        ( CEILING ( ToMinute, StepNow ) - FLOOR ( FromMinute, StepNow ) ) / StepNow >= Bins
                                                                            && ISEMPTY ( FILTER ( BinMinutes, MOD ( [@Minute], StepNow ) <> 0 ) )
                                                                ),
                                                                [@Step]
                                                            ),
                                                            60
                                                        ),
                                                    IF ( SpanMinutes <= 120.000001, 1, IF ( SpanMinutes <= 720.000001, 5, 15 ) )
                                                )
                                            RETURN
                                                IF ( IsHourly, MAX ( 60, SaveStep ), SaveStep )
                                    )
                                VAR Owns =
                                    ADDCOLUMNS (
                                        AtBin,
                                        "@Own",
                                            VAR Captured = 'Telemetry Snapshots'[Captured At UTC]
                                            VAR PointValue = [@Point]
                                            VAR ThisSave = FILTER ( NearSaves, 'Telemetry Snapshots'[Captured At UTC] = Captured )
                                            VAR Grain = MAXX ( ThisSave, [@Grain] )
                                            VAR CutStart = MAX ( Bin, MAXX ( ThisSave, 'Telemetry Snapshots'[Window Start UTC] ) )
                                            VAR CutEnd = MIN ( Bin + Grain / 1440, MAXX ( ThisSave, 'Telemetry Snapshots'[Window End UTC] ) )
                                            VAR SpanStart = IF ( CutStart < CutEnd, CutStart, Bin )
                                            VAR SpanEnd = IF ( CutStart < CutEnd, CutEnd, Bin + Grain / 1440 )
                                            VAR FinerWindows =
                                                FILTER (
                                                    NearSaves,
                                                    ( [@Grain] < Grain || ( [@Grain] = Grain && 'Telemetry Snapshots'[Captured At UTC] > Captured ) )
                                                        && 'Telemetry Snapshots'[Window Start UTC] < SpanEnd
                                                        && 'Telemetry Snapshots'[Window End UTC] > SpanStart
                                                )
                                            RETURN
                                                IF (
                                                    ISEMPTY ( FinerWindows ),
                                                    PointValue,
                                                    // A save's rows lie inside its window, so only a finer save whose window reaches the span can have rows
                                                    // there: its rows' extent is read then, and only then. The context transition's filter on this point's
                                                    // save is removed first.
                                                    VAR Finer =
                                                        FILTER (
                                                            ADDCOLUMNS (
                                                                ADDCOLUMNS (
                                                                    FinerWindows,
                                                                    "@First",
                                                                        VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                                        RETURN
                                                                            CALCULATE (
                                                                                MIN ( 'Telemetry Snapshots'[Bucket UTC] ),
                                                                                REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Captured At UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                                                                REMOVEFILTERS ( 'Date' ),
                                                                                'Telemetry Snapshots'[Captured At UTC] = RowSave
                                                                            ),
                                                                    "@Last",
                                                                        VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                                        RETURN
                                                                            CALCULATE (
                                                                                MAX ( 'Telemetry Snapshots'[Bucket UTC] ),
                                                                                REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Captured At UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                                                                REMOVEFILTERS ( 'Date' ),
                                                                                'Telemetry Snapshots'[Captured At UTC] = RowSave
                                                                            ),
                                                                    "@Count",
                                                                        VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                                        RETURN
                                                                            CALCULATE (
                                                                                DISTINCTCOUNT ( 'Telemetry Snapshots'[Bucket UTC] ),
                                                                                REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Captured At UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                                                                REMOVEFILTERS ( 'Date' ),
                                                                                'Telemetry Snapshots'[Captured At UTC] = RowSave
                                                                            )
                                                                ),
                                                                "@RowFrom", MAX ( [@First], 'Telemetry Snapshots'[Window Start UTC] ),
                                                                "@RowTo", MIN ( [@Last] + [@Grain] / 1440, 'Telemetry Snapshots'[Window End UTC] ),
                                                                "@Dense", [@Count] = ROUND ( ( [@Last] - [@First] ) * 1440 / [@Grain], 0 ) + 1
                                                            ),
                                                            [@RowFrom] < SpanEnd && [@RowTo] > SpanStart
                                                        )
                                                    VAR DenseCover =
                                                        NOT ISEMPTY (
                                                            FILTER (
                                                                Finer,
                                                                [@Dense]
                                                                    && [@RowFrom] <= SpanStart + 0.00000001
                                                                    && [@RowTo] >= SpanEnd - 0.00000001
                                                            )
                                                        )
                                                    RETURN
                                                        IF (
                                                            ISEMPTY ( Finer ),
                                                            PointValue,
                                                            IF (
                                                                DenseCover,
                                                                BLANK (),
                                                                VAR Inside =
                                                                    ADDCOLUMNS (
                                                                        ADDCOLUMNS (
                                                                            FILTER (
                                                                                GROUPBY (
                                                                                    CALCULATETABLE (
                                                                                        'Telemetry Snapshots',
                                                                                        // Every row of the finer saves for this series, whatever its bin, so all of the series' bins share one
                                                                                        // read: the context transition's filters on the bin and the save are removed first. The finer saves
                                                                                        // come from SaveList, so an outside filter on Captured At UTC hides a save here too.
                                                                                        REMOVEFILTERS ( 'Telemetry Snapshots'[Bucket UTC], 'Telemetry Snapshots'[Captured At UTC], 'Telemetry Snapshots'[Report Date UTC] ),
                                                                                        REMOVEFILTERS ( 'Date' ),
                                                                                        TREATAS ( SELECTCOLUMNS ( Finer, "@Save", 'Telemetry Snapshots'[Captured At UTC] ), 'Telemetry Snapshots'[Captured At UTC] )
                                                                                    ),
                                                                                    'Telemetry Snapshots'[Bucket UTC],
                                                                                    'Telemetry Snapshots'[Captured At UTC],
                                                                                    "@Value", SUMX ( CURRENTGROUP (), 'Telemetry Snapshots'[Value] )
                                                                                ),
                                                                                'Telemetry Snapshots'[Bucket UTC] >= Bin
                                                                                    && 'Telemetry Snapshots'[Bucket UTC] < Bin + Grain / 1440
                                                                            ),
                                                                            "@G",
                                                                                VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                                                RETURN MAXX ( FILTER ( Finer, 'Telemetry Snapshots'[Captured At UTC] = RowSave ), [@Grain] ),
                                                                            "@From",
                                                                                VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                                                RETURN MAXX ( FILTER ( Finer, 'Telemetry Snapshots'[Captured At UTC] = RowSave ), 'Telemetry Snapshots'[Window Start UTC] ),
                                                                            "@To",
                                                                                VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                                                RETURN MAXX ( FILTER ( Finer, 'Telemetry Snapshots'[Captured At UTC] = RowSave ), 'Telemetry Snapshots'[Window End UTC] )
                                                                        ),
                                                                        "@CoverStart",
                                                                            VAR RowBin = 'Telemetry Snapshots'[Bucket UTC]
                                                                            VAR RowStart = MAX ( RowBin, [@From] )
                                                                            VAR RowEnd = MIN ( RowBin + [@G] / 1440, [@To] )
                                                                            RETURN IF ( RowStart < RowEnd, RowStart, RowBin ),
                                                                        "@CoverEnd",
                                                                            VAR RowBin = 'Telemetry Snapshots'[Bucket UTC]
                                                                            VAR RowStart = MAX ( RowBin, [@From] )
                                                                            VAR RowEnd = MIN ( RowBin + [@G] / 1440, [@To] )
                                                                            RETURN IF ( RowStart < RowEnd, RowEnd, RowBin + [@G] / 1440 )
                                                                    )
                                                                VAR Ranked =
                                                                    ADDCOLUMNS (
                                                                        Inside,
                                                                        "@Rank",
                                                                            VAR RowGrain = [@G]
                                                                            VAR RowSave = 'Telemetry Snapshots'[Captured At UTC]
                                                                            RETURN 1 + COUNTROWS ( FILTER ( Finer, [@Grain] < RowGrain || ( [@Grain] = RowGrain && 'Telemetry Snapshots'[Captured At UTC] > RowSave ) ) )
                                                                    )
                                                                VAR Level1 =
                                                                    ADDCOLUMNS (
                                                                        ADDCOLUMNS ( FILTER ( Ranked, [@Rank] = 1 ), "@Any", FALSE (), "@Sum", 0.0, "@Covered", FALSE () ),
                                                                        "@Kept", [@Value],
                                                                        "@Taken", [@Value]
                                                                    )
                                                                VAR Level2 =
                                                                    ADDCOLUMNS (
                                                                        ADDCOLUMNS (
                                                                            FILTER ( Ranked, [@Rank] = 2 ),
                                                                            "@Any",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                RETURN NOT ISEMPTY ( FILTER ( Level1, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ) ),
                                                                            "@Sum",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                RETURN 0.0 + SUMX ( FILTER ( Level1, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ), [@Kept] ),
                                                                            "@Covered",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                VAR UnderRows = FILTER ( Level1, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom )
                                                                                RETURN
                                                                                    NOT ISEMPTY ( UnderRows )
                                                                                        && ISEMPTY (
                                                                                            FILTER (
                                                                                                UNION ( ROW ( "@X", RowFrom ), SELECTCOLUMNS ( FILTER ( UnderRows, [@CoverEnd] < RowTo - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                                                                VAR X = [@X]
                                                                                                RETURN ISEMPTY ( FILTER ( UnderRows, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                                                            )
                                                                                        )
                                                                        ),
                                                                        "@Kept", IF ( NOT [@Any], [@Value], IF ( [@Covered], 0.0, MAX ( 0.0, [@Value] - [@Sum] ) ) ),
                                                                        "@Taken", IF ( [@Covered], BLANK (), [@Value] )
                                                                    )
                                                                VAR Upto2 = UNION ( Level1, Level2 )
                                                                VAR Level3 =
                                                                    ADDCOLUMNS (
                                                                        ADDCOLUMNS (
                                                                            FILTER ( Ranked, [@Rank] = 3 ),
                                                                            "@Any",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                RETURN NOT ISEMPTY ( FILTER ( Upto2, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ) ),
                                                                            "@Sum",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                RETURN 0.0 + SUMX ( FILTER ( Upto2, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ), [@Kept] ),
                                                                            "@Covered",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                VAR UnderRows = FILTER ( Upto2, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom )
                                                                                RETURN
                                                                                    NOT ISEMPTY ( UnderRows )
                                                                                        && ISEMPTY (
                                                                                            FILTER (
                                                                                                UNION ( ROW ( "@X", RowFrom ), SELECTCOLUMNS ( FILTER ( UnderRows, [@CoverEnd] < RowTo - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                                                                VAR X = [@X]
                                                                                                RETURN ISEMPTY ( FILTER ( UnderRows, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                                                            )
                                                                                        )
                                                                        ),
                                                                        "@Kept", IF ( NOT [@Any], [@Value], IF ( [@Covered], 0.0, MAX ( 0.0, [@Value] - [@Sum] ) ) ),
                                                                        "@Taken", IF ( [@Covered], BLANK (), [@Value] )
                                                                    )
                                                                VAR Upto3 = UNION ( Upto2, Level3 )
                                                                VAR Level4 =
                                                                    ADDCOLUMNS (
                                                                        ADDCOLUMNS (
                                                                            FILTER ( Ranked, [@Rank] >= 4 ),
                                                                            "@Any",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                RETURN NOT ISEMPTY ( FILTER ( Upto3, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ) ),
                                                                            "@Sum",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                RETURN 0.0 + SUMX ( FILTER ( Upto3, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom ), [@Kept] ),
                                                                            "@Covered",
                                                                                VAR RowFrom = [@CoverStart]
                                                                                VAR RowTo = [@CoverEnd]
                                                                                VAR UnderRows = FILTER ( Upto3, [@CoverStart] < RowTo && [@CoverEnd] > RowFrom )
                                                                                RETURN
                                                                                    NOT ISEMPTY ( UnderRows )
                                                                                        && ISEMPTY (
                                                                                            FILTER (
                                                                                                UNION ( ROW ( "@X", RowFrom ), SELECTCOLUMNS ( FILTER ( UnderRows, [@CoverEnd] < RowTo - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                                                                VAR X = [@X]
                                                                                                RETURN ISEMPTY ( FILTER ( UnderRows, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                                                            )
                                                                                        )
                                                                        ),
                                                                        "@Kept", IF ( NOT [@Any], [@Value], IF ( [@Covered], 0.0, MAX ( 0.0, [@Value] - [@Sum] ) ) ),
                                                                        "@Taken", IF ( [@Covered], BLANK (), [@Value] )
                                                                    )
                                                                VAR Kept = UNION ( Upto3, Level4 )
                                                                VAR UnderPoint = FILTER ( Kept, [@CoverStart] < SpanEnd && [@CoverEnd] > SpanStart )
                                                                VAR CoveredPoint =
                                                                    NOT ISEMPTY ( UnderPoint )
                                                                        && ISEMPTY (
                                                                            FILTER (
                                                                                UNION ( ROW ( "@X", SpanStart ), SELECTCOLUMNS ( FILTER ( UnderPoint, [@CoverEnd] < SpanEnd - 0.00000001 ), "@X", [@CoverEnd] ) ),
                                                                                VAR X = [@X]
                                                                                RETURN ISEMPTY ( FILTER ( UnderPoint, [@CoverStart] <= X + 0.00000001 && [@CoverEnd] > X + 0.00000001 ) )
                                                                            )
                                                                        )
                                                                VAR Highest = MAXX ( UnderPoint, [@Taken] )
                                                                RETURN
                                                                    IF (
                                                                        ISEMPTY ( UnderPoint ),
                                                                        PointValue,
                                                                        IF (
                                                                            CoveredPoint,
                                                                            BLANK (),
                                                                            IF (
                                                                                Adds,
                                                                                MAX ( 0, PointValue - SUMX ( UnderPoint, [@Kept] ) ),
                                                                                IF ( ISBLANK ( Highest ) || PointValue > Highest, PointValue )
                                                                            )
                                                                        )
                                                                    )
                                                            )
                                                        )
                                                )
                                    )
                                RETURN
                                    IF ( Adds, SUMX ( Owns, [@Own] ), MAXX ( Owns, [@Own] ) )
                            )
                    )
            )
        formatString: #,0.##
        isHidden
        displayFolder: Base

    /// Average CPU per bin across the selected targets and period. On T3 the value is a percentage of the service tier's limit.
    measure 'CPU (%)' =
            CALCULATE (
                AVERAGEX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cpu" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "AvgCPU" )
            )
        formatString: #,0.0" %"
        displayFolder: CPU

    /// Highest per-bin CPU peak (MaxCPU) in the selection. On T3 the value is a percentage of the service tier's limit.
    measure 'CPU Peak (%)' =
            CALCULATE (
                MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cpu" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "MaxCPU" )
            )
        formatString: #,0.0" %"
        displayFolder: CPU

    /// CPU (%) only for bins inside an incident window of the targets in context; blank elsewhere, so the line draws the window in indigo.
    measure 'CPU In Incident Window' = IF ( [In Incident Window], [CPU (%)] )
        formatString: #,0.0" %"
        displayFolder: CPU

    /// Highest number of blocked processes in any bin (gauge, maximum per bin).
    measure 'Blocked Processes (peak)' =
            CALCULATE (
                MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "gauges" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Processes blocked" )
            )
        formatString: #,0
        displayFolder: Locks and blocking

    /// Highest number of open transactions in any bin (gauge, maximum per bin).
    measure 'Active Transactions (peak)' =
            CALCULATE (
                MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "gauges" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Active Transactions" )
            )
        formatString: #,0
        displayFolder: Locks and blocking

    /// Highest number of sessions in the ContosoCare database in any bin.
    measure 'Active Sessions (peak)' =
            CALCULATE (
                MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "sessions" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "MaxSessions" )
            )
        formatString: #,0
        displayFolder: Locks and blocking

    /// Seconds spent in the Lock wait category, summed over the selected bins (wait deltas are stored in milliseconds per bin).
    measure 'Lock Wait (s)' =
            DIVIDE (
                CALCULATE (
                    [Snapshot Value],
                    KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "wait_deltas" ),
                    KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Lock" )
                ),
                1000
            )
        formatString: #,0.0
        displayFolder: Locks and blocking

    /// Deadlocks in the selected bins: per-bin deltas of the cumulative Number of Deadlocks/sec counter.
    measure Deadlocks =
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "counter_deltas" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Number of Deadlocks/sec" )
            )
        formatString: #,0
        displayFolder: Locks and blocking

    /// Seconds of Buffer IO page-latch waits (PAGEIOLATCH): data pages read from storage. The IO-pressure and missing-index signal.
    measure 'Buffer IO Wait (s)' =
            DIVIDE (
                CALCULATE (
                    [Snapshot Value],
                    KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "wait_deltas" ),
                    KEEPFILTERS ( FILTER ( ALL ( 'Telemetry Snapshots'[Metric] ), CONTAINSSTRING ( 'Telemetry Snapshots'[Metric], "(PAGEIOLATCH)" ) ) )
                ),
                1000
            )
        formatString: #,0.0
        displayFolder: Waits and IO

    /// Seconds of Log Rate Governor waits: Azure SQL Database's log-rate governance, the T3 log-rate scenario's signature.
    measure 'Log Rate Governor Wait (s)' =
            DIVIDE (
                CALCULATE (
                    [Snapshot Value],
                    KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "wait_deltas" ),
                    KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Log Rate Governor" )
                ),
                1000
            )
        formatString: #,0.0
        displayFolder: Waits and IO

    /// Seconds of non-idle wait time in the selection, for every wait category in context.
    measure 'Wait Time (s)' =
            DIVIDE ( CALCULATE ( [Snapshot Value], KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "wait_deltas" ) ), 1000 )
        formatString: #,0.0
        displayFolder: Waits and IO

    /// Bar fill for the wait ranking: Warning amber when a signature category (Lock, PAGEIOLATCH, Log Rate Governor) holds 10 % or more of the wait time, neutral otherwise.
    measure 'Wait Bar Color' =
            VAR Category = SELECTEDVALUE ( 'Telemetry Snapshots'[Metric] )
            VAR Share = DIVIDE ( [Wait Time (s)], CALCULATE ( [Wait Time (s)], REMOVEFILTERS ( 'Telemetry Snapshots'[Metric] ) ) )
            VAR IsSignature = Category IN { "Lock", "Log Rate Governor" } || CONTAINSSTRING ( Category, "(PAGEIOLATCH)" )
            RETURN IF ( IsSignature && Share >= 0.1, "#FFB020", "#B4B4C2" )
        isHidden
        displayFolder: Waits and IO

    /// Megabytes read and written on data and log files in the selected bins.
    measure 'Data and Log IO (MB)' =
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "storage_io" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] IN { "ReadMB", "WriteMB" } )
            )
        formatString: #,0.0
        displayFolder: Waits and IO

    /// Batch requests in the selected bins: per-bin deltas of the cumulative Batch Requests/sec counter. The load axis of the explorer's scatter.
    measure 'Batch Requests' =
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "counter_deltas" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "Batch Requests/sec" )
            )
        formatString: #,0
        displayFolder: Waits and IO

    /// The signal picked in the explorer's Signal slicer (CPU, average per bin, when none is picked), in the signal's own unit and format.
    measure 'Signal Value' =
            SWITCH (
                SELECTEDVALUE ( 'Signal'[Signal Key], "cpu" ),
                "cpu", [CPU (%)],
                "cpu_peak", [CPU Peak (%)],
                "blocked", [Blocked Processes (peak)],
                "lock_wait", [Lock Wait (s)],
                "deadlocks", [Deadlocks],
                "transactions", [Active Transactions (peak)],
                "buffer_io_wait", [Buffer IO Wait (s)],
                "io_mb", [Data and Log IO (MB)],
                "log_rate_wait", [Log Rate Governor Wait (s)],
                "batch_requests", [Batch Requests],
                "sessions", [Active Sessions (peak)]
            )
        displayFolder: Explorer
        formatStringDefinition = SELECTEDVALUE ( 'Signal'[Format String], "#,0.0" )

    /// Signal Value only for bins inside an incident window of the targets in context.
    measure 'Signal Value In Incident Window' = IF ( [In Incident Window], [Signal Value] )
        displayFolder: Explorer
        formatStringDefinition = SELECTEDVALUE ( 'Signal'[Format String], "#,0.0" )

    /// The selected signal's attention threshold for the explorer's reference line; blank when the signal has none.
    measure 'Signal Threshold' =
            VAR T = SELECTEDVALUE ( 'Signal'[Attention Threshold] )
            RETURN IF ( T > 0, T )
        formatString: #,0.#
        displayFolder: Explorer

    /// Highest per-bin value of the selected signal in context.
    measure 'Signal Peak' =
            MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Signal Value] )
        formatString: #,0.#
        isHidden
        displayFolder: Explorer

    /// Explorer page title: the selected signal and the SQL target with its highest bin, or an empty-state sentence.
    measure 'Explorer Headline' =
            VAR SignalName = SELECTEDVALUE ( 'Signal'[Signal], "CPU, average per bin" )
            VAR Unit = SELECTEDVALUE ( 'Signal'[Unit], "%" )
            VAR Candidates =
                FILTER (
                    CALCULATETABLE ( VALUES ( 'Target'[Target Short] ), 'Target'[Target Kind] = "SQL target" ),
                    NOT ISBLANK ( [Signal Peak] )
                )
            VAR Best = TOPN ( 1, Candidates, [Signal Peak], DESC )
            VAR BestTarget = MAXX ( Best, 'Target'[Target Short] )
            VAR BestPeak = MAXX ( Best, [Signal Peak] )
            RETURN
                IF (
                    ISBLANK ( BestTarget ),
                    SignalName & ": no telemetry bins in this selection",
                    SignalName & " by target: the highest bin was " & FORMAT ( BestPeak, "#,0.#" ) & " " & Unit & " on " & BestTarget
                )
        displayFolder: Explorer

    /// The explorer's active signal, SQL targets, and data range, for the breadcrumb next to the title.
    measure 'Active Filters Summary' =
            VAR Targets =
                CONCATENATEX (
                    CALCULATETABLE ( VALUES ( 'Target'[Target Short] ), 'Target'[Target Kind] = "SQL target" ),
                    'Target'[Target Short], ", ", 'Target'[Target Short], ASC
                )
            VAR FirstDay = CALCULATE ( MIN ( 'Telemetry Snapshots'[Report Date UTC] ) )
            VAR LastDay = CALCULATE ( MAX ( 'Telemetry Snapshots'[Report Date UTC] ) )
            RETURN
                "Signal: " & SELECTEDVALUE ( 'Signal'[Signal], "CPU, average per bin" )
                    & "  ·  Targets: " & Targets
                    & IF ( NOT ISBLANK ( FirstDay ), "  ·  Data from " & FORMAT ( FirstDay, "d mmm yyyy" ) & " to " & FORMAT ( LastDay, "d mmm yyyy" ) & " UTC" )
        displayFolder: Explorer

    /// How many of the three SQL targets sent CPU telemetry in the selected period.
    measure 'Targets Reporting' =
            COUNTROWS (
                FILTER (
                    CALCULATETABLE ( VALUES ( 'Target'[Target Key] ), 'Target'[Target Kind] = "SQL target" ),
                    NOT ISBLANK ( [CPU (%)] )
                )
            )
        formatString: #,0
        displayFolder: Estate

    /// Age of the target's newest telemetry sample when the notebook captured the window (estate pulse), the larger across targets.
    measure 'Telemetry Lag at Capture (min)' =
            CALCULATE (
                MAXX ( VALUES ( 'Telemetry Snapshots'[Target Key] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "estate_pulse" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "LastSampleAgeMinutes" )
            )
        formatString: #,0.0
        displayFolder: Estate

    /// Reference line for each target tile: peak CPU, blocking incidents, and telemetry lag, or an empty-state sentence.
    measure 'Target Tile Context' =
            IF (
                ISBLANK ( [CPU (%)] ),
                "No telemetry bins in this period",
                "Peak CPU " & FORMAT ( [CPU Peak (%)], "0" ) & " %  ·  "
                    & FORMAT ( [Blocking Incidents] + 0, "0" ) & " blocking incident(s)  ·  telemetry lag "
                    & FORMAT ( [Telemetry Lag at Capture (min)], "0" ) & " min"
            )
        displayFolder: Estate

    /// Health matrix font color for CPU Peak (%): Warning amber at 80 % or more.
    measure 'CPU Peak Font Color' = IF ( [CPU Peak (%)] >= 80, "#FFB020", "#F2F2F5" )
        isHidden
        displayFolder: Estate

    /// Health matrix font color for Blocked Processes (peak): Warning amber above 0.
    measure 'Blocked Font Color' = IF ( [Blocked Processes (peak)] > 0, "#FFB020", "#F2F2F5" )
        isHidden
        displayFolder: Estate

    /// Health matrix font color for Buffer IO Wait (s): Warning amber at 1 s or more.
    measure 'Buffer IO Font Color' = IF ( [Buffer IO Wait (s)] >= 1, "#FFB020", "#F2F2F5" )
        isHidden
        displayFolder: Estate

    /// Health matrix font color for Log Rate Governor Wait (s): Warning amber above 0.
    measure 'Log Rate Font Color' = IF ( [Log Rate Governor Wait (s)] > 0, "#FFB020", "#F2F2F5" )
        isHidden
        displayFolder: Estate

    /// The text twin of the health matrix colors, so color is never the only signal: every threshold the target crossed, or None.
    measure 'Target Attention Signals' =
            VAR Parts =
                {
                    IF ( [CPU Peak (%)] >= 80, "▲ CPU" ),
                    IF ( [Blocked Processes (peak)] > 0, "▲ Blocking" ),
                    IF ( [Buffer IO Wait (s)] >= 1, "▲ Buffer IO" ),
                    IF ( [Log Rate Governor Wait (s)] > 0, "▲ Log rate" )
                }
            VAR Result = CONCATENATEX ( FILTER ( Parts, NOT ISBLANK ( [Value] ) ), [Value], "  " )
            RETURN IF ( Result = "", "None", Result )
        displayFolder: Estate

    /// Newest capture time in the lakehouse across snapshots, findings, and checks. Ignores the period slicer.
    measure 'Latest Capture UTC' =
            CALCULATE (
                MAX (
                    MAX ( 'Telemetry Snapshots'[Captured At UTC] ),
                    MAX ( MAX ( 'Analysis Findings'[Captured At UTC] ), MAX ( 'Validation Results'[Checked At UTC] ) )
                ),
                REMOVEFILTERS ( 'Date' )
            )
        formatString: yyyy-mm-dd hh:nn
        displayFolder: Freshness

    /// Hours between the newest capture and now (UTC).
    measure 'Hours Since Latest Capture' =
            VAR Latest = [Latest Capture UTC]
            RETURN IF ( NOT ISBLANK ( Latest ), DIVIDE ( DATEDIFF ( Latest, UTCNOW (), MINUTE ), 60 ) )
        formatString: #,0.0
        displayFolder: Freshness

    /// Pass while the history is fresh, Warning after 24 hours, Manual action required with no snapshot at all.
    measure 'History Freshness Status' =
            VAR Hours = [Hours Since Latest Capture]
            RETURN SWITCH ( TRUE (), ISBLANK ( Hours ), "Manual action required", Hours > 24, "Warning", "Pass" )
        displayFolder: Freshness

    /// Rail color of the history tile: cyan with no snapshot, amber after 24 hours, unlit otherwise.
    measure 'History Freshness Rail Color' =
            SWITCH ( [History Freshness Status], "Manual action required", "#8CEEEE", "Warning", "#FFB020", "#2A2A3A" )
        isHidden
        displayFolder: Freshness

    /// The history tile's reference line: the newest capture and its age, or what to run when there's none.
    measure 'History Freshness Label' =
            IF (
                ISBLANK ( [Latest Capture UTC] ),
                "No snapshot yet: run NB_DatabaseHub_LiveActivity",
                "Latest snapshot " & FORMAT ( [Latest Capture UTC], "yyyy-mm-dd hh:nn" ) & " UTC  ·  "
                    & FORMAT ( [Hours Since Latest Capture], "0.0" ) & " h ago"
            )
        displayFolder: Freshness

    /// Notebook runs that saved telemetry snapshots, over all history.
    measure 'Notebook Runs Captured' = CALCULATE ( DISTINCTCOUNT ( 'Telemetry Snapshots'[Run ID] ), REMOVEFILTERS ( 'Date' ) )
        formatString: #,0
        displayFolder: Freshness

    /// 1 when the lakehouse holds any per-bin telemetry, whatever the filters; drives every empty state.
    measure 'Has Telemetry Bins' =
            IF (
                CALCULATE (
                    COUNTROWS ( 'Telemetry Snapshots' ),
                    REMOVEFILTERS (),
                    'Telemetry Snapshots'[Analysis Key] IN { "cpu", "gauges", "wait_deltas", "counter_deltas", "sessions", "storage_io" }
                ) > 0,
                1,
                0
            )
        formatString: 0
        isHidden
        displayFolder: Freshness

    /// Telemetry tables that each target sent, from the deployment notebook's coverage check in the validation run the readiness page selects.
    measure 'Coverage Tables (selected run)' =
            VAR RunId = [Selected Validation Run]
            RETURN
                CALCULATE (
                    DISTINCTCOUNT ( 'Telemetry Snapshots'[Metric] ),
                    KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "telemetry_coverage" ),
                    KEEPFILTERS ( RIGHT ( 'Telemetry Snapshots'[Metric], 5 ) = ".rows" ),
                    TREATAS ( { RunId }, 'Telemetry Snapshots'[Run ID] ),
                    REMOVEFILTERS ( 'Date' )
                )
        formatString: #,0
        displayFolder: Coverage

    /// Minutes between the target's newest telemetry sample and the end of the coverage window, in the selected validation run.
    measure 'Coverage Last Sample Age (min)' =
            VAR RunId = [Selected Validation Run]
            VAR CoverageRows =
                CALCULATETABLE (
                    'Telemetry Snapshots',
                    KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "telemetry_coverage" ),
                    TREATAS ( { RunId }, 'Telemetry Snapshots'[Run ID] ),
                    REMOVEFILTERS ( 'Date' )
                )
            VAR LastSample = MAXX ( CoverageRows, 'Telemetry Snapshots'[Bucket UTC] )
            VAR WindowEnd = MAXX ( CoverageRows, 'Telemetry Snapshots'[Window End UTC] )
            RETURN IF ( NOT ISBLANK ( LastSample ), DATEDIFF ( LastSample, WindowEnd, SECOND ) / 60 )
        formatString: #,0.0
        displayFolder: Coverage

    /// Fresh, stale (older than 15 minutes, the deployment notebook's freshness rule), or not captured, with a glyph.
    measure 'Coverage Attention' =
            VAR Age = [Coverage Last Sample Age (min)]
            RETURN SWITCH ( TRUE (), ISBLANK ( Age ), "○ Not captured", Age > 15, "▲ Stale", "✓ Fresh" )
        displayFolder: Coverage

    /// Font color for the coverage spotlight: Warning amber when the newest sample is older than 15 minutes.
    measure 'Coverage Font Color' = IF ( [Coverage Last Sample Age (min)] > 15, "#FFB020", "#8C8C9C" )
        isHidden
        displayFolder: Coverage

    /// T5's peak normalized RU consumption in the selection (NormalizedRUConsumption, maximum per bin; analysis cosmosdb), 0 to 100 %: Database Hub's Peak Norm RU %. At 100 % T5 used all of its provisioned throughput in at least one second of a bin, and further requests are throttled (429).
    measure 'Peak Norm RU (%)' =
            CALCULATE (
                MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "NormalizedRUConsumption" )
            )
        formatString: #,0.0" %"
        displayFolder: Cosmos DB

    /// T5's requests in the selected bins (TotalRequests, count per bin), the throttled ones included: what the 429 rate divides by. A period that two saves hold at different intervals counts once (F35: Snapshot Value).
    measure 'Cosmos DB Requests' =
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "TotalRequests" )
            )
        formatString: #,0
        displayFolder: Cosmos DB

    /// T5's throttled requests in the selected bins: TotalRequests with status code 429 (request rate too large), Database Hub's Throttled Requests (429s). 0 when T5 served requests and none was throttled.
    measure 'Throttled Requests (429s)' =
            VAR Throttled =
                CALCULATE (
                    [Snapshot Value],
                    KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                    KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "ThrottledRequests" )
                )
            RETURN IF ( ISBLANK ( Throttled ) && NOT ISBLANK ( [Cosmos DB Requests] ), 0, Throttled )
        formatString: #,0
        displayFolder: Cosmos DB

    /// Share of T5's requests in the selection that were throttled (429s), in percent: Database Hub's 429 Rate %.
    measure '429 Rate (%)' = DIVIDE ( [Throttled Requests (429s)], [Cosmos DB Requests] ) * 100
        formatString: #,0.0" %"
        displayFolder: Cosmos DB

    /// Request units T5 consumed in the selected bins (TotalRequestUnits, total per bin): Database Hub's Total RU consumed.
    measure 'RU Consumed' =
            CALCULATE (
                [Snapshot Value],
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "TotalRequestUnits" )
            )
        formatString: #,0
        displayFolder: Cosmos DB

    /// T5's provisioned throughput in RU/s in the selection (ProvisionedThroughput, maximum per hour): Database Hub's Provisioned RU/s, to compare with what it consumed.
    measure 'Provisioned RU/s' =
            CALCULATE (
                MAXX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "ProvisionedThroughput" )
            )
        formatString: #,0
        displayFolder: Cosmos DB

    /// T5's availability in the selection (ServiceAvailability, the average of its hourly values), as Database Hub's Performance shows it. A throttled request isn't a failure, so an ru-storm leaves it at 100 %.
    measure 'Cosmos DB Availability (%)' =
            CALCULATE (
                AVERAGEX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "ServiceAvailability" )
            )
        formatString: #,0.00" %"
        displayFolder: Cosmos DB

    /// T5's server-side latency of gateway requests in the selection (ServerSideLatencyGateway, the average of its per-bin averages), in milliseconds. The workload runner uses gateway mode, so Database Hub's Avg Latency (direct mode) stays empty.
    measure 'Cosmos DB Gateway Latency (ms)' =
            CALCULATE (
                AVERAGEX ( SUMMARIZE ( 'Telemetry Snapshots', 'Telemetry Snapshots'[Target Key], 'Telemetry Snapshots'[Bucket UTC] ), [Snapshot Value] ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Analysis Key] = "cosmosdb" ),
                KEEPFILTERS ( 'Telemetry Snapshots'[Metric] = "ServerSideLatencyGateway" )
            )
        formatString: #,0.0
        displayFolder: Cosmos DB

    /// 1 when the lakehouse holds any T5 (Azure Cosmos DB) metric, whatever the filters; drives the Cosmos DB view's empty state.
    measure 'Has Cosmos DB Bins' =
            IF (
                CALCULATE (
                    COUNTROWS ( 'Telemetry Snapshots' ),
                    REMOVEFILTERS (),
                    'Telemetry Snapshots'[Analysis Key] = "cosmosdb"
                ) > 0,
                1,
                0
            )
        formatString: 0
        isHidden
        displayFolder: Cosmos DB

    /// The Cosmos DB view's title: T5's peak normalized RU and its throttled requests (429s) in the selection, or an empty-state sentence while the lakehouse has no T5 history.
    measure 'Cosmos DB Headline' =
            VAR Peak = [Peak Norm RU (%)]
            VAR Throttled = [Throttled Requests (429s)]
            VAR PeakText = IF ( ISBLANK ( Peak ), "an unknown", FORMAT ( Peak, "0" ) & " %" )
            RETURN
                SWITCH (
                    TRUE (),
                    [Has Cosmos DB Bins] = 0, "No Azure Cosmos DB history yet: a session's end, stop-demo.ps1 -SaveHistory, or deploy.ps1 saves T5's Azure Monitor metrics",
                    ISBLANK ( Peak ) && ISBLANK ( Throttled ), "No T5 metrics in this period",
                    Throttled > 0, "T5 reached " & PeakText & " normalized RU with " & FORMAT ( Throttled, "#,0" ) & " throttled requests (" & FORMAT ( [429 Rate (%)], "0.0" ) & " % of its requests) in this period",
                    "T5 had no throttled requests in this period; normalized RU peaked at " & PeakText
                )
        displayFolder: Cosmos DB

    column 'Run ID'
        dataType: string
        isHidden
        sourceColumn: run_id

    column 'Source Notebook'
        dataType: string
        isHidden
        sourceColumn: source_notebook

    column 'Captured At UTC'
        dataType: dateTime
        isHidden
        formatString: yyyy-mm-dd hh:nn
        sourceColumn: captured_at_utc

    column 'Analysis Key'
        dataType: string
        isHidden
        sourceColumn: analysis

    column 'Target Key'
        dataType: string
        isHidden
        sourceColumn: target

    /// Azure resource type of the target: virtualMachines (T1), machines (T2), or servers/databases (T3).
    column 'Resource Type'
        dataType: string
        sourceColumn: resource_type

    /// Azure resource name of the target.
    column 'Resource Name'
        dataType: string
        sourceColumn: resource_name

    /// SQL Server instance name.
    column 'Instance Name'
        dataType: string
        sourceColumn: instance_name

    /// Database name, where the analysis is per database.
    column 'Database Name'
        dataType: string
        sourceColumn: database_name

    /// The metric or wait category, for example AvgCPU, Processes blocked, Lock, or Buffer IO (PAGEIOLATCH).
    column Metric
        dataType: string
        sourceColumn: metric

    /// Start of the telemetry bin (UTC). Empty for analyses with one row per window; the latest sample time for memory, growth, and coverage.
    column 'Bucket UTC'
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn
        sourceColumn: bucket_utc

    column Value
        dataType: double
        isHidden
        summarizeBy: none
        sourceColumn: value

    /// Unit of Value, for example percent, rows, or MB.
    column Unit
        dataType: string
        sourceColumn: unit

    column 'Window Start UTC'
        dataType: dateTime
        isHidden
        formatString: yyyy-mm-dd hh:nn
        sourceColumn: window_start_utc

    column 'Window End UTC'
        dataType: dateTime
        isHidden
        formatString: yyyy-mm-dd hh:nn
        sourceColumn: window_end_utc

    column 'Report Date UTC'
        dataType: dateTime
        isHidden
        formatString: yyyy-mm-dd
        sourceColumn: report_date_utc

    partition 'Telemetry Snapshots' = entity
        mode: directLake
        source
            entityName: telemetry_snapshots
            schemaName: dbo
            expressionSource: 'DirectLake - LH_DatabaseHub'
