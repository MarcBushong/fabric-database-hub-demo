/// The six ADR 0012 statuses, worst first: Fail, Manual action required, Warning, Pass, Not supported, and Not selected. Only the first three need attention and carry a color; the rest stay graphite.
table Status

    /// The status word, sorted by severity.
    column Status
        dataType: string
        isNameInferred
        sourceColumn: [Status]
        sortByColumn: 'Status Sort'

    /// Short status word for chips and tiles.
    column 'Status Short'
        dataType: string
        isNameInferred
        sourceColumn: [Status Short]
        sortByColumn: 'Status Sort'

    column 'Status Sort'
        dataType: int64
        isHidden
        isNameInferred
        summarizeBy: none
        sourceColumn: [Status Sort]

    /// Yes for Fail, Manual action required, and Warning; No for the other three.
    column 'Needs Attention'
        dataType: string
        isNameInferred
        sourceColumn: [Needs Attention]

    column 'Needs Attention Flag'
        dataType: int64
        isHidden
        isNameInferred
        summarizeBy: none
        sourceColumn: [Needs Attention Flag]

    /// The status glyph that pairs with its color, so color is never the only signal: ✕ ⚑ ▲ ✓ ⊘ ○.
    column 'Status Glyph'
        dataType: string
        isNameInferred
        sourceColumn: [Status Glyph]
        sortByColumn: 'Status Sort'

    /// Hex color for conditional formatting: red, cyan, or amber for attention statuses, graphite otherwise.
    column 'Status Color'
        dataType: string
        isHidden
        isNameInferred
        sourceColumn: [Status Color]

    /// What the status means (ADR 0012).
    column 'Status Meaning'
        dataType: string
        isNameInferred
        sourceColumn: [Status Meaning]

    partition Status = calculated
        mode: import
        source =
                DATATABLE (
                    "Status", STRING, "Status Short", STRING, "Status Sort", INTEGER,
                    "Needs Attention", STRING, "Needs Attention Flag", INTEGER,
                    "Status Glyph", STRING, "Status Color", STRING, "Status Meaning", STRING,
                    {
                        { "Fail", "Fail", 1, "Yes", 1, "✕", "#FF4D5A", "A selected capability is broken, or a prerequisite is missing" },
                        { "Manual action required", "Manual", 2, "Yes", 1, "⚑", "#8CEEEE", "A documented manual step is pending" },
                        { "Warning", "Warning", 3, "Yes", 1, "▲", "#FFB020", "It works, but with a risk to address" },
                        { "Pass", "Pass", 4, "No", 0, "✓", "#8C8C9C", "Functionally verified" },
                        { "Not supported", "Not supported", 5, "No", 0, "⊘", "#8C8C9C", "The docs say the capability doesn't apply" },
                        { "Not selected", "Not selected", 6, "No", 0, "○", "#8C8C9C", "The operator turned the capability off" }
                    }
                )
