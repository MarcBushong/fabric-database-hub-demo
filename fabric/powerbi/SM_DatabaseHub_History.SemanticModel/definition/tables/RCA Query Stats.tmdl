/// One Query Store plan's runtime statistics over one Query Store interval on one target, as one read saw it (on PostgreSQL, one role's query: its rows are per query). A later read of the same interval holds the same plan's counts or more, so readers keep the latest read of each target, interval, login, query, and plan (rca/README.md, Query Store). The Incident RCA's sidecar (ADR 0031): Query Store's evidence, which the observer beside the workload read and NB_DatabaseHub_LiveActivity writes from its sidecar documents, each under its own session's run (rca/history-tables.json).
table 'RCA Query Stats'

    /// Query Store's CPU time in context, in milliseconds: the latest read of each target, interval, login, query, and plan, summed, so several reads of one interval, or two sessions' reads of it, count it once.
    measure 'Query CPU (ms)' = SUMX ( SUMMARIZE ( 'RCA Query Stats', 'RCA Query Stats'[Target Key], 'RCA Query Stats'[Interval Start UTC], 'RCA Query Stats'[Login], 'RCA Query Stats'[Query ID], 'RCA Query Stats'[Plan ID] ), VAR latest = CALCULATE ( MAX ( 'RCA Query Stats'[Captured At UTC] ) ) RETURN CALCULATE ( SUM ( 'RCA Query Stats'[CPU (ms)] ), 'RCA Query Stats'[Captured At UTC] = latest ) )
        formatString: #,0
        displayFolder: RCA

    /// Query Store's elapsed time in context, in milliseconds: the latest read of each target, interval, login, query, and plan, summed.
    measure 'Query Duration (ms)' = SUMX ( SUMMARIZE ( 'RCA Query Stats', 'RCA Query Stats'[Target Key], 'RCA Query Stats'[Interval Start UTC], 'RCA Query Stats'[Login], 'RCA Query Stats'[Query ID], 'RCA Query Stats'[Plan ID] ), VAR latest = CALCULATE ( MAX ( 'RCA Query Stats'[Captured At UTC] ) ) RETURN CALCULATE ( SUM ( 'RCA Query Stats'[Duration (ms)] ), 'RCA Query Stats'[Captured At UTC] = latest ) )
        formatString: #,0
        displayFolder: RCA

    /// Query Store's executions in context: the latest read of each target, interval, login, query, and plan, summed.
    measure 'Query Executions' = SUMX ( SUMMARIZE ( 'RCA Query Stats', 'RCA Query Stats'[Target Key], 'RCA Query Stats'[Interval Start UTC], 'RCA Query Stats'[Login], 'RCA Query Stats'[Query ID], 'RCA Query Stats'[Plan ID] ), VAR latest = CALCULATE ( MAX ( 'RCA Query Stats'[Captured At UTC] ) ) RETURN CALCULATE ( SUM ( 'RCA Query Stats'[Executions] ), 'RCA Query Stats'[Captured At UTC] = latest ) )
        formatString: #,0
        displayFolder: RCA

    /// Query Store's wait time in context, every category, in milliseconds (PostgreSQL's an estimate from its samples): the latest read of each target, interval, login, query, and plan, summed.
    measure 'Query Wait (ms)' = SUMX ( SUMMARIZE ( 'RCA Query Stats', 'RCA Query Stats'[Target Key], 'RCA Query Stats'[Interval Start UTC], 'RCA Query Stats'[Login], 'RCA Query Stats'[Query ID], 'RCA Query Stats'[Plan ID] ), VAR latest = CALCULATE ( MAX ( 'RCA Query Stats'[Captured At UTC] ) ) RETURN CALCULATE ( SUM ( 'RCA Query Stats'[Wait (ms)] ), 'RCA Query Stats'[Captured At UTC] = latest ) )
        formatString: #,0
        displayFolder: RCA

    /// The notebook's RUN_ID: session-<SESSION_ID> for a control session, as the other history tables. A sidecar's rows take their own session's, session-<sessionId>, whichever run wrote them (rca/README.md, The sidecar).
    column 'Run ID'
        dataType: string
        isHidden
        sourceColumn: run_id

    /// The document the row came from (documentId): an evidence document's, or a sidecar's.
    column 'Document ID'
        dataType: string
        isHidden
        sourceColumn: document_id

    /// When the observer read the interval (UTC). Of two reads of one interval, the later one holds the whole of it.
    column 'Captured At UTC'
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn:ss
        sourceColumn: captured_at_utc

    /// T1, T2, T3, or T4.
    column 'Target Key'
        dataType: string
        isHidden
        sourceColumn: target

    /// Start of the Query Store interval: SQL Server's sys.query_store_runtime_stats_interval.start_time, PostgreSQL's query_store.qs_view.start_time.
    column 'Interval Start UTC'
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn
        sourceColumn: interval_start_utc

    /// End of the interval. An interval SQL Server still had open when it was read, at the capture's end, ends after captured_at_utc.
    column 'Interval End UTC'
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn
        sourceColumn: interval_end_utc

    /// Query Store's query_id: SQL Server's within the database; PostgreSQL's 64-bit hash of the statement's parse tree.
    column 'Query ID'
        dataType: int64
        summarizeBy: none
        sourceColumn: query_id

    /// Query Store's plan_id: SQL Server's within the database; on PostgreSQL, qs_view's own, 0 when it reports none (T4 stores no plans: pg_qs.store_query_plans stays off).
    column 'Plan ID'
        dataType: int64
        summarizeBy: none
        sourceColumn: plan_id

    /// PostgreSQL's role that ran the query (qs_view's user_id), for the workload's own role only; another role's rows are summed with a null login (rca/README.md, Names). Null on SQL Server, whose Query Store records no user.
    column Login
        dataType: string
        sourceColumn: login_name

    /// SQL Server's query_hash, as 0x and 16 hexadecimal digits; null on PostgreSQL, whose query_id is the hash.
    column 'Query Hash'
        dataType: string
        sourceColumn: query_hash

    /// SQL Server's query_plan_hash, as 0x and 16 hexadecimal digits; null on PostgreSQL.
    column 'Plan Hash'
        dataType: string
        sourceColumn: plan_hash

    /// The stored procedure, function, or trigger the statement belongs to, [schema].[name]; null for an ad hoc statement, and on PostgreSQL.
    column Module
        dataType: string
        sourceColumn: module_name

    /// The statement as Query Store keeps it, normalized as RCA Sessions' are (literals replaced, comments removed, at most 2,000 characters).
    column Statement
        dataType: string
        sourceColumn: statement_text

    /// Executions in the interval, aborted and failed ones included: SQL Server's count_executions, PostgreSQL's calls.
    column Executions
        dataType: int64
        formatString: #,0
        summarizeBy: none
        sourceColumn: executions

    /// Executions the client cancelled or that ended in an error (SQL Server's execution types Aborted and Exception); null on PostgreSQL.
    column 'Aborted Executions'
        dataType: int64
        formatString: #,0
        summarizeBy: none
        sourceColumn: aborted_executions

    /// Total CPU time in milliseconds (SQL Server's avg_cpu_time times executions); null on PostgreSQL, whose Query Store records no CPU time.
    column 'CPU (ms)'
        dataType: double
        formatString: #,0.#
        summarizeBy: none
        sourceColumn: cpu_ms

    /// Total elapsed time in milliseconds: SQL Server's avg_duration times executions, PostgreSQL's total_time.
    column 'Duration (ms)'
        dataType: double
        formatString: #,0.#
        summarizeBy: none
        sourceColumn: duration_ms

    /// The longest single execution in milliseconds: SQL Server's max_duration, PostgreSQL's max_time.
    column 'Max Duration (ms)'
        dataType: double
        formatString: #,0.#
        summarizeBy: none
        sourceColumn: max_duration_ms

    /// Pages read: SQL Server's 8-KB pages (avg_logical_io_reads times executions); PostgreSQL's shared blocks hit and read.
    column 'Logical Reads'
        dataType: double
        formatString: #,0
        summarizeBy: none
        sourceColumn: logical_reads

    /// Pages read from storage: SQL Server's avg_physical_io_reads times executions; PostgreSQL's shared blocks read.
    column 'Physical Reads'
        dataType: double
        formatString: #,0
        summarizeBy: none
        sourceColumn: physical_reads

    /// Rows returned or changed: SQL Server's avg_rowcount times executions, PostgreSQL's rows.
    column Rows
        dataType: double
        formatString: #,0
        summarizeBy: none
        sourceColumn: row_count

    /// Transaction log the statement wrote, in bytes (SQL Server's avg_log_bytes_used times executions); null on PostgreSQL.
    column 'Log Bytes'
        dataType: double
        formatString: #,0
        summarizeBy: none
        sourceColumn: log_bytes

    /// tempdb space used, in KB (SQL Server's avg_tempdb_space_used times executions, in 8-KB pages); on PostgreSQL its temporary blocks written, 8 KB each.
    column 'Tempdb (KB)'
        dataType: double
        formatString: #,0
        summarizeBy: none
        sourceColumn: tempdb_kb

    /// The largest memory grant one execution used, in KB (SQL Server's max_query_max_used_memory, in 8-KB pages); null on PostgreSQL.
    column 'Max Memory Grant (KB)'
        dataType: double
        formatString: #,0
        summarizeBy: none
        sourceColumn: max_used_memory_kb

    /// The highest degree of parallelism (SQL Server's max_dop); null on PostgreSQL.
    column 'Max DOP'
        dataType: int64
        summarizeBy: none
        sourceColumn: max_dop

    /// Time it waited, every wait category: SQL Server's sys.query_store_wait_stats; PostgreSQL's sampled waits, an estimate (RCA Query Waits). Null when nothing was recorded.
    column 'Wait (ms)'
        dataType: double
        formatString: #,0
        summarizeBy: none
        sourceColumn: wait_ms

    /// When the plan's first execution in the interval ended (SQL Server's first_execution_time, which is an execution's end time): not the instant a plan changed. Null on PostgreSQL.
    column 'First Execution UTC'
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn:ss
        sourceColumn: first_execution_utc

    /// When the plan's last execution in the interval ended (SQL Server's last_execution_time); null on PostgreSQL.
    column 'Last Execution UTC'
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn:ss
        sourceColumn: last_execution_utc

    /// The UTC date of the row's primary time; relates the table to Date, as the other history tables.
    column 'Report Date UTC'
        dataType: dateTime
        isHidden
        formatString: yyyy-mm-dd
        sourceColumn: report_date_utc

    partition 'RCA Query Stats' = entity
        mode: directLake
        source
            entityName: rca_query_stats
            schemaName: dbo
            expressionSource: 'DirectLake - LH_DatabaseHub'
