{
  "name": "dbhub-insights",
  "description": "Database Hub Insights (preview): a read-only Fabric App over the SM_DatabaseHub_History semantic model. Started from the Fabric Apps data app template (microsoft/fabric-apps-analytic-templates, MIT).",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:licenses": "node scripts/check-licenses.mjs",
    "queries:export": "tsx scripts/export-queries.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:licenses && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@microsoft/rayfin-auth": "1.36.2",
    "@microsoft/rayfin-auth-provider-fabric": "1.36.2",
    "@microsoft/rayfin-client": "1.36.2",
    "@microsoft/rayfin-connector-fabric-semanticmodel": "1.36.2",
    "@microsoft/rayfin-connectors": "1.36.2",
    "@types/d3-interpolate": "3.0.4",
    "d3-array": "3.2.4",
    "d3-hierarchy": "3.1.2",
    "d3-interpolate": "3.0.1",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "framer-motion": "12.40.0",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@microsoft/rayfin-cli": "1.36.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/d3-array": "3.2.2",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-sankey": "0.12.5",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.3.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "rollup-plugin-license": "3.7.1",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
