root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,bicep,bicepparam,md,ipynb,props,csproj,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
# PowerShell files are ASCII-only so Windows PowerShell 5.1 reads them correctly.
charset = latin1

[*.{cmd,bat}]
end_of_line = crlf
