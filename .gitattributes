# Normalize line endings in the repository; scripts run on Windows and Linux.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary

# Generated from infra/main.bicep; CI checks it stays in sync.
azuredeploy.json linguist-generated=true
**/packages.lock.json linguist-generated=true
