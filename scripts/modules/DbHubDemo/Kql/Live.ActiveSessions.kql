// Active sessions in the demo database per bin: the most and the average per sample, and how many were running.
// SqlServerActiveSessions is a 30-second gauge table in
// https://learn.microsoft.com/fabric/database/hub/microsoft-sql-query-performance-monitoring-telemetry
// (checked 2026-10-21). Rules applied: 1 (filter on SampleTimeUTC first), 4 (group by SqlServerInstanceName
// per target); the aggregation limits the rows (rule 10).
// Contract: runs after Live.Prelude.kql, which defines _start, _end, _bin, _rg, _db, and _target(). The body is
// identical to SESSIONS_KQL in fabric/notebooks/NB_DatabaseHub_LiveActivity.ipynb, and the Real-Time Dashboard
// (fabric/realtime) is generated from this file; tests/unit/Fabric.Dashboard.Tests.ps1 fails if they drift.
SqlServerActiveSessions
| where SampleTimeUTC between (_start .. _end)
| where ResourceGroup =~ _rg
| where DatabaseName =~ _db
| extend Target = _target(ResourceType, ResourceName)
| where isnotempty(Target)
| summarize Sessions = dcount(SessionID), Running = dcountif(SessionID, SessionStatus == 'running')
        by Target, SqlServerInstanceName, SampleTimeUTC
| summarize MaxSessions = max(Sessions), AvgSessions = avg(Sessions), MaxRunning = max(Running)
        by Target, SqlServerInstanceName, Bucket = bin(SampleTimeUTC, _bin)
| order by Bucket asc
