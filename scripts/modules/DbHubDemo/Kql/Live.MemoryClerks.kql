// Memory per clerk type at the latest sample in the last hour of the window. Based on query 7 ('What is using
// memory on one resource?') in
// https://learn.microsoft.com/fabric/database/hub/microsoft-sql-query-performance-monitoring-telemetry
// (checked 2026-10-21). Rules applied: 1 (filter on SampleTimeUTC first), 4 (group by SqlServerInstanceName
// per target), 10 (row limit). SqlServerMemoryUtilization is a gauge, so the latest sample per clerk is read.
// Contract: runs after Live.Prelude.kql, which defines _start, _end, _bin, _rg, _db, and _target(). The body is
// identical to MEMORY_KQL in fabric/notebooks/NB_DatabaseHub_LiveActivity.ipynb, and the Real-Time Dashboard
// (fabric/realtime) is generated from this file; tests/unit/Fabric.Dashboard.Tests.ps1 fails if they drift.
SqlServerMemoryUtilization
| where SampleTimeUTC between ((_end - 1h) .. _end)
| where ResourceGroup =~ _rg
| extend Target = _target(ResourceType, ResourceName)
| where isnotempty(Target)
| summarize arg_max(SampleTimeUTC, MemorySizeMB) by Target, SqlServerInstanceName, MemoryClerkType, MemoryClerkName
| summarize MemoryMB = round(sum(MemorySizeMB), 1), LastSampleUTC = max(SampleTimeUTC) by Target, SqlServerInstanceName, MemoryClerkType
| where MemoryMB >= 1
| order by Target asc, MemoryMB desc
| take 1000
